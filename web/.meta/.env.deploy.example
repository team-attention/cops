# ===========================================
# Deployment Environment Variables
# ===========================================
# These variables are used by the Makefile for building and deploying.
# Copy this file to .env.deploy.{ENV} (e.g., .env.deploy.prod) and fill in the values.

# GCP Project
GCP_PROJECT=your-gcp-project-id

# GCS Bucket for static hosting
GCS_BUCKET=your-bucket-name

# Cloud CDN URL Map name
CDN_URL_MAP=your-cdn-url-map

# CDN URL (for deployment output message)
CDN_URL=https://your-domain.com
