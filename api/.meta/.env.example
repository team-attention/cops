# Application Configuration
APP_NAME=cops-api
APP_VERSION=0.0.1
APP_ENV=development

# HTTP Server Configuration
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=30s

# CORS Configuration
# Comma-separated list of allowed origins (use * for all origins in development)
HTTP_CORS_ALLOW_ORIGINS=*
HTTP_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
HTTP_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Connect-Protocol-Version

# Logging Configuration
LOGGING_LEVEL=info
LOGGING_FORMAT=json

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cops

JWT_SECRET_KEY=KvA26N9ZsW3roRZCjKr7tU+ph/Ol2JPMP6FCQ3jpdZQ=
JWT_ACCESS_TOKEN_DURATION=30m
JWT_REFRESH_TOKEN_DURATION=720h
JWT_ISSUER=cops
GOOGLE_CLIENT_ID=Google OAuth 클라이언트 ID
GOOGLE_CLIENT_SECRET=Google OAuth 클라이언트 시크릿
GOOGLE_SCOPES=email,profile