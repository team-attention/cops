# ===========================================
# API Deployment Configuration
# ===========================================
# Copy this file to .env.{ENV} (e.g., .env.prod, .env.staging)

# Artifact Registry host (e.g., asia-northeast3-docker.pkg.dev)
ARTIFACT_REGISTRY=asia-northeast3-docker.pkg.dev

# GCP Project ID
GCP_PROJECT=your-gcp-project

# Artifact Registry repository name
REGISTRY_REPOSITORY=cops

# Docker image name
IMAGE_NAME=api

# Cloud Run service name
CLOUD_RUN_SERVICE=cops-api

# Cloud Run region
CLOUD_RUN_REGION=asia-northeast3

# ===========================================
# Resulting image tag format:
# ${ARTIFACT_REGISTRY}/${GCP_PROJECT}/${REGISTRY_REPOSITORY}/${IMAGE_NAME}:${VERSION}
# Example: asia-northeast3-docker.pkg.dev/my-project/cops/api:v1.0.0
# ===========================================
